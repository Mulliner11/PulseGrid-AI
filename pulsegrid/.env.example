# 复制本文件为 .env 后填写。不要把真实密钥提交到仓库。
# Groq 只做意图理解和策略说明，不计算价格、网格或下单参数。

GROQ_API_KEY=your_groq_api_key
# 默认 openai/gpt-oss-120b。llama-3.3-70b-versatile 会 404。只做意图和说明，不算价。
GROQ_MODEL=openai/gpt-oss-120b

# Telegram BotFather 发放的令牌
TELEGRAM_BOT_TOKEN=123456:replace_with_your_bot_token

# OKX API。先在模拟盘创建密钥，确认流程后再换实盘密钥。
OKX_API_KEY=your_okx_api_key
OKX_SECRET_KEY=your_okx_secret_key
OKX_PASSPHRASE=your_okx_passphrase

# 0=实盘，1=模拟盘。保持 1，除非你明确要交易真实资金。
OKX_FLAG=1

# AI Builder Code。每次下单/再平衡都会写入 OKX 请求字段 tag，用于成交量归因和手续费返佣。
OKX_AI_BUILDER_CODE=your_ai_builder_code

# 可选
OKX_BASE_URL=https://www.okx.com
DEFAULT_KLINE_BAR=15m
MONITOR_INTERVAL_SEC=8
LOG_LEVEL=INFO
